{
  "name": "devtree-marketing",
  "private": true,
  "description": "DevTree promo videos, made with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render DevTreePromo out/devtree-promo.mp4 && remotion render DevTreeSquare out/devtree-promo-square.mp4",
    "render:promo": "remotion render DevTreePromo out/devtree-promo.mp4",
    "render:square": "remotion render DevTreeSquare out/devtree-promo-square.mp4",
    "still": "remotion still DevTreePromo out/devtree-promo-poster.png --frame=75",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@remotion/cli": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
